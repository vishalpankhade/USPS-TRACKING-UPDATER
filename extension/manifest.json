{
  "manifest_version": 3,
  "name": "USPS Bulk Tracker Dashboard – Zero Cost",
  "version": "2.5.0",
  "description": "Track unlimited USPS tracking numbers through the official USPS tracking website with 35-number batches, one safe automatic retry, not-loaded batch recovery, and optional Google Sheets sync.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://tools.usps.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Open USPS Tracker Dashboard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tools.usps.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
